# OpenDota key is optional. Copy this file to /etc/dota-observer/collector.env
# on the VPS and set the real key there if you have one. Never commit the real key.
OPENDOTA_API_KEY=
MIN_MMR=6000
POLL_SECONDS=30
MIN_INTERVAL=1.1
DAILY_BUDGET=0
GAME_MODES=
LOBBY_TYPES=
INCLUDE_LEAGUE_GAMES=0
STALE_SECONDS=600
